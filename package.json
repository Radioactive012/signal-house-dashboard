{
  "name": "signal-house-n8n-mastery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:static": "node --env-file-if-exists=.env scripts/prepare-static.mjs",
    "dev": "npm run prepare:static && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:preview": "DEV_BYPASS_AUTH=true npm run dev",
    "build": "npm run prepare:static && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:offline": "REQUIRE_SUPABASE_CONFIG=false npm run build",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
